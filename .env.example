# TigerGraph connection. Savanna uses a database secret (minted under
# Database Secrets in the workspace); Community Edition uses username/password.
TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPH=FraudGraph
TG_SECRET=your-database-secret
TG_USERNAME=tigergraph
TG_PASSWORD=

# Google Gemini (free tier is sufficient). https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key
